# Backend — Required Environment Variables
# Copy this file to .env and fill in the values. NEVER commit .env to git.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Local development:
#   DATABASE_URL=postgresql://YOUR_POSRGRES_USER@localhost:5432/surubus
#   DATABASE_SSL=false
#
# Railway (production) — copy from Railway PostgreSQL plugin dashboard:
#   DATABASE_URL=postgresql://postgres:xxxxx@containers-us-west-xxx.railway.app:5432/railway
#   DATABASE_SSL=true
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:19000

# ─── OSM / OSRM Routing Proxy ──────────────────────────────────────────────────
# Leave blank to use the free OSRM demo server (http://router.project-osrm.org)
# Set to your own OSRM or OpenRouteService instance URL for production.
OSRM_BASE_URL=

# ─── Monitoring ────────────────────────────────────────────────────────────────
# Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info
