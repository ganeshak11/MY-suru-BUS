# Backend — Required Environment Variables
# Copy this file to .env and fill in the values. NEVER commit .env to git.

# PostgreSQL connection string (e.g. Supabase hosted Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase requires SSL — set to 'true'. Only 'false' for local Postgres without SSL.
DATABASE_SSL=true

# Server port
PORT=3001

# Set to "production" in production
NODE_ENV=development

# A strong random secret for signing JWTs (min 32 characters)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Comma-separated list of allowed CORS origins (no trailing slash)
# Example: https://youradmin.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:19000

# Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info
