# Passenger App — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Backend API base URL.
# In DEVELOPMENT: leave this blank. The app auto-detects the backend
# host from Expo's Metro bundler (works on any device on the same LAN).
# In PRODUCTION: set this to your deployed backend URL.
EXPO_PUBLIC_API_BASE_URL=
